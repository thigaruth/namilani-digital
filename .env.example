# ---------------------------------------------------------------------------
# Namilani Digital — environment configuration
# Copy this file to .env.local and fill in the values you have available.
# Never commit .env.local or any real API keys.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonical URLs, sitemap and OG.
NEXT_PUBLIC_SITE_URL=https://namilanidigital.com

# Where enquiries are delivered.
CONTACT_EMAIL=info@namilanidigital.com

# Resend configuration.
# Create an API key at https://resend.com and verify your sending domain.
# Until both values are configured, the contact form will show an honest
# "not connected" message with email and WhatsApp fallbacks instead of
# pretending the enquiry was sent.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
# Example: Namilani Digital <website@namilanidigital.com>
CONTACT_FROM_EMAIL=

# Optional social profiles. Leave blank to hide the link in the footer.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Optional: set a different public WhatsApp number if it ever changes.
# Defaults to the number in lib/site.ts when left blank.
NEXT_PUBLIC_WHATSAPP_NUMBER=
